{
    // Panelization config for fader_buddy_main, applied with:
    //   kikit panelize -p electronics/fader_buddy_main-kikit_panelize.json \
    //       electronics/fader_buddy_main.kicad_pcb electronics/build/panelized_fader_buddy_main.kicad_pcb
    //
    // A single board is 59 x 17mm, so a 2x5 grid plus a 10mm frame and the
    // vertical backbone yields a panel of 154 x 128mm containing 10 boards.
    "layout": {
        "type": "grid",
        "rows": 5,
        "cols": 2,
        // Row-to-row gap. Each of these joints is cut twice (once at each
        // board's outline), so the leftover strip between two boards is
        // exactly this wide -- keep it wide enough to grab and snap off as one
        // piece.
        "vspace": "4mm",
        // A vertical backbone runs the full height of the panel between the
        // two columns, stiffening the panel during assembly. KiKit adds hspace
        // on each side of it, so the column-to-column gap is
        // 2mm + 5mm + 2mm = 9mm: a rigid spine with short 2mm tab stubs
        // reaching it (roughly the 1.4mm the boards sit off the frame).
        // vbonecut perforates the backbone where it meets the top and bottom
        // rails, so the whole spine comes away with them. KiKit would also
        // perforate it at every row boundary; the cuts plugin below drops
        // those so the spine stays rigid. The board-to-backbone cuts all stay
        // at the hand-picked tab positions, clear of the vias and tooling
        // holes.
        "hspace": "2mm",
        "vbackbone": "5mm",
        "vbonecut": true,
        // Leave ${COMMIT_HASH}/${RELEASE_VERSION} etc. as-is; they get
        // substituted later by ci/electronics/export_util.py and KiBot.
        "baketext": false
    },
    "tabs": {
        // Explicit tab positions -- see electronics/kikit_faderbuddy_tabs.py for
        // why the built-in evenly-spaced tabs don't work for this outline.
        "type": "plugin",
        "code": "electronics/kikit_faderbuddy_tabs.py.FaderBuddyTabs",
        // hwidth: single tab on each short (left/right) edge
        // vwidth: single row-to-row tab on each long (top/bottom) edge
        "hwidth": "5mm",
        "vwidth": "5mm"
    },
    "cuts": {
        // Mousebites, minus the backbone's row-boundary cuts -- see
        // electronics/kikit_faderbuddy_cuts.py
        "type": "plugin",
        "code": "electronics/kikit_faderbuddy_cuts.py.FaderBuddyCuts",
        "drill": "0.6mm",
        "spacing": "1mm",
        "offset": "-0.1mm"
    },
    "framing": {
        "type": "frame",
        "width": "10mm",
        "space": "1.4mm",
        // Only horizontal corner cuts, so the left/right rails snap off while
        // the top/bottom rails stay attached to them (and to the backbone)
        "cuts": "h"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "14mm",
        "voffset": "4mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "post": {
        "millradius": "0.7mm",
        // Refill the copper zones after panelization so they keep clearance
        // from the mousebite holes and the new tab/frame edges
        "refillzones": true
    },
    "source": {
        "type": "auto"
    }
}
