{
    // Panelization config for fader_buddy_main, applied with:
    //   kikit panelize -p electronics/fader_buddy_main-kikit_panelize.json \
    //       electronics/fader_buddy_main.kicad_pcb electronics/build/panelized_fader_buddy_main.kicad_pcb
    //
    // A single board is 59 x 17mm, so a 2x5 grid plus a 5mm frame yields a
    // panel of roughly 132 x 103mm containing 10 boards.
    "layout": {
        "type": "grid",
        "rows": 5,
        "cols": 2,
        "space": "1.4mm",
        // Leave ${COMMIT_HASH}/${RELEASE_VERSION} etc. as-is; they get
        // substituted later by ci/electronics/export_util.py and KiBot.
        "baketext": false
    },
    "tabs": {
        "type": "fixed",
        // Tabs only on the left/right (17mm) edges of each board: the long
        // top/bottom edges have LEDs and test pads within 1mm of the outline,
        // which mousebite drills would encroach on.
        "hcount": 2,
        "hwidth": "3mm",
        "vcount": 0,
        "vwidth": "3mm",
        "mindistance": "1mm"
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.6mm",
        "spacing": "1mm",
        "offset": "-0.1mm"
    },
    "framing": {
        "type": "frame",
        "width": "5mm",
        "space": "1.4mm",
        // Cut the frame at all four corners so each rail snaps off cleanly
        "cuts": "both"
    },
    "fiducials": {
        "type": "4fid",
        "hoffset": "6mm",
        "voffset": "2.5mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "text": {
        "type": "simple",
        "text": "FaderBuddy -- snap off the top and bottom rails first",
        "anchor": "mt",
        "voffset": "2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.5mm",
        "height": "1.5mm",
        "thickness": "0.25mm"
    },
    "text2": {
        "type": "simple",
        "text": "then the side rails, then separate the individual boards",
        "anchor": "mb",
        "voffset": "-2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.5mm",
        "height": "1.5mm",
        "thickness": "0.25mm"
    },
    "post": {
        "millradius": "0.7mm"
    },
    "source": {
        "type": "auto"
    }
}
